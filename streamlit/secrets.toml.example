# HOW TO USE THIS FILE
# 1. Do NOT upload this exact file to GitHub with a real key in it.
# 2. On Streamlit Community Cloud: go to your app's Settings -> Secrets,
#    and paste in the line below with your real key. Streamlit Cloud stores
#    it securely on the server side — it never reaches the browser or GitHub.
# 3. If working in GitHub Codespaces, copy this file to secrets.toml (same
#    folder) and fill in your real key there. secrets.toml is already listed
#    in .gitignore so it will never be committed by accident.

GROQ_API_KEY = "your-groq-api-key-here"
